{
  "name": "pocket-ui",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native/assets-registry": "0.88.1",
    "expo": "~58.1.0",
    "expo-blur": "~58.0.6",
    "expo-haptics": "~58.0.8",
    "expo-status-bar": "~58.0.5",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/addon-a11y": "10.6.9",
    "@storybook/addon-docs": "10.6.9",
    "@storybook/addon-themes": "10.6.9",
    "@storybook/addon-vitest": "10.6.9",
    "@storybook/react-native-web-vite": "10.6.9",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@vitest/browser": "5.1.2",
    "@vitest/browser-playwright": "5.1.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.9",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.16",
    "playwright": "1.65.1",
    "prettier": "^3.10.1",
    "storybook": "10.6.9",
    "typescript": "~6.0.3",
    "vite": "^7.3.8",
    "vitest": "5.1.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "screenshots": "bash scripts/screenshots/capture.sh",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:stories": "vitest run",
    "new:component": "node scripts/new-component.mjs"
  },
  "private": true,
  "description": "Pocket-sized React Native components, production-ready on every screen.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-reanimated/jest/resolver",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|phosphor-react-native|react-native-reanimated|react-native-worklets)"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/storybook-static/"
    ]
  }
}
